// Serika Social — durable state.
//
// This is NOT the identity source of truth. Credentials live in serika-accounts; the
// `users` table here mirrors that record keyed by `accountsId`. Live instance rosters live
// in Redis, not here — Postgres only holds what must survive a restart.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Mirror of a serika-accounts user. Never store passwords here.
model User {
  id            String    @id @default(uuid()) @db.Uuid
  accountsId    String    @unique @map("accounts_id")
  username      String    @unique
  displayName   String?   @map("display_name")
  avatarUrl     String?   @map("avatar_url")
  isPremium     Boolean   @default(false) @map("is_premium")
  isAdmin       Boolean   @default(false) @map("is_admin")
  /// Trust ladder 0..8 — see TrustRank in api/src/trust.ts.
  /// 0=visitor 1=newcomer 2=member 3=regular 4=known 5=creator 6=trusted 7=partner 8=verified-creator
  trustLevel    Int       @default(0) @map("trust_level")
  currentAvatarId String? @map("current_avatar_id") @db.Uuid
  homeWorldId   String?   @map("home_world_id") @db.Uuid
  homeWorld     World?    @relation("PersonalHome", fields: [homeWorldId], references: [id], onDelete: SetNull)
  lastSeen      DateTime? @map("last_seen")
  createdAt     DateTime  @default(now()) @map("created_at")

  authoredWorlds  World[]   @relation("WorldAuthor")
  authoredAvatars Avatar[]  @relation("AvatarAuthor")
  ownedInstances  Instance[] @relation("InstanceOwner")
  friendsA        Friend[]  @relation("FriendA")
  friendsB        Friend[]  @relation("FriendB")
  following       Follow[]  @relation("Follower")
  followers       Follow[]  @relation("Followed")
  blocks          Block[]  @relation("BlockUser")
  blockedBy       Block[]  @relation("BlockBlocked")
  favorites       Favorite[]
  reviews         Review[]
  reportsFiled    Report[] @relation("ReportReporter")
  reportsAgainst  Report[] @relation("ReportTargetUser")
  reportsResolved Report[] @relation("ReportResolver")
  notifications      Notification[] @relation("NotificationUser")
  notificationsCaused Notification[] @relation("NotificationActor")
  newsPosts          NewsPost[]     @relation("NewsPostAuthor")
  newsComments       NewsComment[]  @relation("NewsCommentAuthor")
  hubVisits          UserWorldVisit[]

  @@index([lastSeen(sort: Desc)])
  @@map("users")
}

/// A durable per-user notification. Gateway push is best-effort and only reaches a user who
/// happens to be connected, so this table — not the socket — is the source of truth: an invite
/// or friend request sent while the recipient is offline is still here when they come back.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// friend_request | friend_accepted | invite | world_review | system
  kind      String
  /// Who caused it, when a person is behind it. SetNull so deleting an account keeps history.
  actorId   String?   @map("actor_id") @db.Uuid
  title     String
  body      String    @default("")
  /// Where tapping it goes — a `serikasocial://` deep link or a web route.
  link      String?
  /// Kind-specific extras (worldId, instanceId, …). Read defensively; shape varies by kind.
  data      Json?
  /// Invites go stale — a join that is hours old is worse than no button at all.
  expiresAt DateTime? @map("expires_at")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user  User  @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// The unread-badge query.
  @@index([userId, readAt])
  /// The list query.
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// 0=pending 1=accepted (a single row per pair, userA < userB by id).
model Friend {
  userAId   String   @map("user_a_id") @db.Uuid
  userBId   String   @map("user_b_id") @db.Uuid
  status    Int      @default(0)
  /// Who sent the request — needed to render incoming vs outgoing while pending.
  requestedById String @map("requested_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  userA User @relation("FriendA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendB", fields: [userBId], references: [id], onDelete: Cascade)

  @@id([userAId, userBId])
  @@index([userBId])
  @@map("friends")
}

model Block {
  userId    String   @map("user_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User @relation("BlockUser", fields: [userId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([userId, blockedId])
  @@map("blocks")
}

/// Asymmetric follow (Twitter-style): follower → followed. No acceptance needed.
model Follow {
  followerId String   @map("follower_id") @db.Uuid
  followedId String   @map("followed_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@index([followedId])
  @@map("follows")
}

model World {
  id                 String   @id @default(uuid()) @db.Uuid
  authorId           String?  @map("author_id") @db.Uuid
  name               String
  description        String   @default("")
  tags               String[] @default([])
  capacity           Int      @default(16)
  /// 0=private 1=community 2=public
  releaseStatus      Int      @default(0) @map("release_status")
  /// Force dedicated relay even for small instances (author override).
  forceDedicated     Boolean  @default(false) @map("force_dedicated")
  /// True for the shipped starter world — cannot be deleted, always joinable.
  isBuiltin          Boolean  @default(false) @map("is_builtin")
  /// The world new players land in as their personal Home (admin-selectable, single default).
  isDefaultHome      Boolean  @default(false) @map("is_default_home")
  publishedVersionId String?  @map("published_version_id") @db.Uuid
  visitCount         BigInt   @default(0) @map("visit_count")
  /// Decayed popularity for the browser sort.
  heat               Float    @default(0)
  createdAt          DateTime @default(now()) @map("created_at")

  isUnlisted Boolean @default(false) @map("is_unlisted")
  eventOnly Boolean @default(false) @map("event_only")
  events LiveEvent[]

  homeFor   User[]        @relation("PersonalHome")
  author    User?          @relation("WorldAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  versions  WorldVersion[]
  instances Instance[]
  reviews   Review[]
  reports   Report[] @relation("ReportTargetWorld")

  @@index([tags], type: Gin)
  @@index([heat(sort: Desc)])
  @@map("worlds")
}

model WorldVersion {
  id              String   @id @default(uuid()) @db.Uuid
  worldId         String   @map("world_id") @db.Uuid
  version         Int
  /// 0=uploaded 1=building 2=ready 3=failed
  buildStatus     Int      @default(0) @map("build_status")
  /// Review state machine — see ReviewStatus in api/src/review.ts.
  /// 0=draft 1=submitted 2=auto_approved 3=in_review 4=changes_requested 5=approved 6=rejected 7=withdrawn
  reviewStatus    Int      @default(0) @map("review_status")
  /// Set when SerikaScript bytecode / executable content is detected in the bundle.
  hasScript       Boolean  @default(false) @map("has_script")
  /// Automated validator verdict (asset budget, whitelist, script static-analysis).
  validatorReport Json?    @map("validator_report")
  reviewedById    String?  @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at")
  reviewNotes     String   @default("") @map("review_notes")
  createdAt       DateTime @default(now()) @map("created_at")

  world   World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  assets  WorldAsset[]
  reviews WorldReview[]

  @@unique([worldId, version])
  @@index([reviewStatus])
  @@map("world_versions")
}

/// One immutable row per review decision on a world version. The queue reads the version's
/// `reviewStatus`; this table is the durable history behind it.
model WorldReview {
  id             String   @id @default(uuid()) @db.Uuid
  worldVersionId String   @map("world_version_id") @db.Uuid
  reviewerId     String   @map("reviewer_id") @db.Uuid
  /// 0=approve 1=reject 2=request_changes
  decision       Int
  notes          String   @default("")
  /// True when the "reviewer" is the top-trust author self-publishing (spot-audit candidate).
  selfPublish    Boolean  @default(false) @map("self_publish")
  createdAt      DateTime @default(now()) @map("created_at")

  version WorldVersion @relation(fields: [worldVersionId], references: [id], onDelete: Cascade)

  @@index([worldVersionId])
  @@map("world_reviews")
}

/// Immutable audit trail for privileged actions that aren't moderation of a user: trust
/// grants, self-publishes, publish/unpublish. See api/src/audit.ts.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  /// e.g. "trust.grant", "world.self_publish", "world.publish", "world.unpublish"
  action    String
  /// Free-form subject reference (user id, world version id, ...).
  subjectId String?  @map("subject_id") @db.Uuid
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([action])
  @@index([subjectId])
  @@map("audit_log")
}

model WorldAsset {
  versionId String @map("version_id") @db.Uuid
  /// 0=windows 1=linux 2=android
  platform  Int
  blake3    Bytes
  bytes     BigInt
  cdnKey    String @map("cdn_key")

  version WorldVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@id([versionId, platform])
  @@map("world_assets")
}

model Avatar {
  id                 String   @id @default(uuid()) @db.Uuid
  authorId           String?  @map("author_id") @db.Uuid
  name               String
  /// 0=private 1=community 2=public
  releaseStatus      Int      @default(0) @map("release_status")
  /// VRChat-style tier: 0=excellent 1=good 2=medium 3=poor 4=verypoor
  perfRank           Int      @default(0) @map("perf_rank")
  /// 0=builtin 1=vrm 2=gltf 3=fbx
  sourceFormat       Int      @default(0) @map("source_format")
  isBuiltin          Boolean  @default(false) @map("is_builtin")
  /// Offered to everyone as a selectable default outfit (admin-curated). Suisei is the first.
  isDefaultOutfit    Boolean  @default(false) @map("is_default_outfit")
  thumbnailKey       String?  @map("thumbnail_key")
  publishedVersionId String?  @map("published_version_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")

  author   User?           @relation("AvatarAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  versions AvatarVersion[]

  @@map("avatars")
}

model AvatarVersion {
  id        String   @id @default(uuid()) @db.Uuid
  avatarId  String   @map("avatar_id") @db.Uuid
  version   Int
  blake3    Bytes?
  stats     Json?
  cdnKey    String?  @map("cdn_key")
  createdAt DateTime @default(now()) @map("created_at")

  avatar Avatar @relation(fields: [avatarId], references: [id], onDelete: Cascade)

  @@unique([avatarId, version])
  @@map("avatar_versions")
}

/// Durable record of an instance. The live roster is in Redis; this row is closed
/// (closedAt set) when the instance ends.
model Instance {
  id             String    @id @default(uuid()) @db.Uuid
  worldId        String    @map("world_id") @db.Uuid
  worldVersionId String?   @map("world_version_id") @db.Uuid
  ownerId        String?   @map("owner_id") @db.Uuid
  /// 0=public 1=friends 2=friends-of-friends 3=invite 4=private
  access         Int       @default(0)
  /// 0=p2p 1=dedicated
  mode           Int       @default(1)
  region         String    @default("eu-central")
  nodeId         String?   @map("node_id")
  endpoint       String?
  capacity       Int       @default(16)
  playerCount    Int       @default(0) @map("player_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  closedAt       DateTime? @map("closed_at")

  eventId String? @map("event_id") @db.Uuid
  event LiveEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  owner User? @relation("InstanceOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([worldId, closedAt])
  @@index([nodeId])
  @@map("instances")
}

model Favorite {
  userId   String   @map("user_id") @db.Uuid
  /// 0=world 1=avatar 2=user
  kind     Int
  targetId String   @map("target_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind, targetId])
  @@map("favorites")
}

/// A user's rating + written review of a world. One row per (world, user) — upsert on POST.
model Review {
  id        String   @id @default(cuid())
  worldId   String   @map("world_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// 1..5
  rating    Int
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([worldId, userId])
  @@index([worldId])
  @@map("reviews")
}

model ModerationAction {
  id         String    @id @default(uuid()) @db.Uuid
  actorId    String?   @map("actor_id") @db.Uuid
  targetId   String    @map("target_id") @db.Uuid
  instanceId String?   @map("instance_id") @db.Uuid
  /// 0=warn 1=kick 2=instance-ban 3=platform-ban 4=trust-grant
  kind       Int
  reason     String    @default("")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([targetId])
  @@map("moderation_actions")
}

/// A user-submitted abuse report against a user or a world. Exactly one of
/// targetUserId / targetWorldId is set, keyed by targetType. Reports are immutable once
/// filed; resolution writes status/notes/resolvedBy. See api/src/routes/reports.ts.
model Report {
  id            String    @id @default(uuid()) @db.Uuid
  reporterId    String    @map("reporter_id") @db.Uuid
  /// 0=user 1=world
  targetType    Int       @map("target_type")
  targetUserId  String?   @map("target_user_id") @db.Uuid
  targetWorldId String?   @map("target_world_id") @db.Uuid
  /// 0=harassment 1=hate_speech 2=sexual_content 3=violence_gore 4=spam_scam
  /// 5=impersonation 6=cheating 7=inappropriate_content 8=other
  category      Int
  details       String    @default("")
  /// Where the reporter was when they filed (context for moderators); optional.
  instanceId    String?   @map("instance_id") @db.Uuid
  /// 0=open 1=actioned 2=dismissed
  status        Int       @default(0)
  resolvedById  String?   @map("resolved_by_id") @db.Uuid
  resolutionNotes String  @default("") @map("resolution_notes")
  resolvedAt    DateTime? @map("resolved_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  reporter    User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser  User? @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetWorld World? @relation("ReportTargetWorld", fields: [targetWorldId], references: [id], onDelete: Cascade)
  resolvedBy  User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([reporterId, status])
  @@index([targetUserId])
  @@index([targetWorldId])
  @@map("reports")
}

/// Server-clock show state. Config is frozen while open; clients seek on late join.
model LiveEvent {
  id String @id @default(uuid()) @db.Uuid
  worldId String @map("world_id") @db.Uuid
  title String
  bannerKey String @map("banner_key")
  config Json
  status String @default("draft")
  revision Int @default(0)
  startedAt DateTime? @map("started_at")
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  instances Instance[]
  @@index([status])
  @@map("live_events")
}

/// A Hub news post / announcement (markdown body). Drafts have publishedAt = null and are
/// only visible through the admin API; publishing sets the timestamp.
model NewsPost {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  title       String
  body        String
  /// Optional CDN key of a cover image.
  imageKey    String?   @map("image_key")
  /// Optional HubApp this post announces (a release announcement links its app).
  appId       String?   @map("app_id") @db.Uuid
  pinned      Boolean   @default(false)
  /// Null = draft, hidden from the public list.
  publishedAt DateTime? @map("published_at")
  authorId    String?   @map("author_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  comments NewsComment[] @relation("NewsPostComments")
  app     HubApp? @relation(fields: [appId], references: [id], onDelete: SetNull)
  author  User?   @relation("NewsPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([publishedAt(sort: Desc)])
  @@map("hub_news_posts")
}

/// An in-app comment on a news post. Authenticated users only; the Hub renders these
/// under the article view.
model NewsComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  post NewsPost @relation("NewsPostComments", fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation("NewsCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt(sort: Desc)])
  @@map("hub_news_comments")
}

/// A Serika desktop app the Hub catalogues, installs and updates: Serika Social, Serika Moe
/// desktop, future apps. Rows are data — the Hub treats them all through the same
/// HubApp/HubRelease contract, no special cases.
model HubApp {
  id       String  @id @default(uuid()) @db.Uuid
  slug     String  @unique
  name     String
  /// One line. This is the CARD text — keep it short; `description` is the store page.
  blurb    String  @default("")
  /// Optional CDN key of the app icon: the small square mark, used in lists and shortcuts.
  iconKey  String? @map("icon_key")
  /// Wide hero art (CDN key) for the store page and the Discover spotlight. Deliberately
  /// separate from iconKey — a square icon stretched into a banner is what the procedural
  /// SVG placeholders were papering over.
  coverKey String? @map("cover_key")
  /// Long-form markdown shown on the app's own page.
  description String @default("")
  /// Short marketing line under the name on the store page.
  tagline  String  @default("")
  developer String @default("")
  publisher String @default("")
  /// Ordered CDN keys. Postgres text[]; order is the display order.
  screenshots String[] @default([])
  /// Free-form category tags for browsing and filtering.
  tags     String[] @default([])
  /// game | app
  kind     String  @default("app")
  homepage String?
  supportUrl String? @map("support_url")
  sourceUrl  String? @map("source_url")
  /// External video URL for the store page hero.
  trailerUrl String? @map("trailer_url")
  /// Manual ordering in the catalogue; ties break on name.
  sortOrder Int @default(0) @map("sort_order")
  /// GitHub "owner/repo" — the admin sync endpoint imports the latest release's assets
  /// as HubRelease rows (this is how Serika Streaming publishes).
  githubRepo String? @map("github_repo")
  /// Hidden from the public catalogue until an admin marks it visible.
  visible  Boolean @default(false)

  news     NewsPost[]
  releases HubRelease[]

  @@map("hub_apps")
}

/// One distributable build of a HubApp on one platform/channel. This is what makes the Hub
/// update ANY Serika desktop app — including Serika Social itself — via the same
/// stage → verify → swap contract the in-game updater uses.
model HubRelease {
  id          String   @id @default(uuid()) @db.Uuid
  appId       String   @map("app_id") @db.Uuid
  version     String
  /// stable | beta | nightly
  channel     String   @default("stable")
  /// windows-x86_64 | linux-x86_64 | macos-universal | android-quest-arm64 | android-mobile-arm64
  platform    String
  /// Absolute CDN URL (or CDN key) the Hub downloads from.
  url         String
  sha256      String
  sizeBytes   BigInt   @default(0) @map("size_bytes")
  notes       String   @default("")
  publishedAt DateTime @default(now()) @map("published_at")

  app HubApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, channel, platform, version])
  @@index([appId, platform, publishedAt(sort: Desc)])
  @@map("hub_releases")
}

/// Recent-worlds history for the Hub's Home tab. Upserted by the instance-join paths —
/// the client never reports it. The newest 50 distinct worlds per user are kept.
model UserWorldVisit {
  userId    String   @map("user_id") @db.Uuid
  worldId   String   @map("world_id") @db.Uuid
  visitedAt DateTime @default(now()) @map("visited_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, worldId])
  @@index([userId, visitedAt(sort: Desc)])
  @@map("user_world_visits")
}
