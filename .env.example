# ─── Datastores ───────────────────────────────────────────────────────────────
# Coolify: project SerikaSocial (pv9x2f6sbqyca45bqjige851), env production
DATABASE_URL=postgresql://serika_social:CHANGEME@CHANGEME_DB_HOST:5490/serika_social
REDIS_URL=redis://:CHANGEME@CHANGEME_DB_HOST:6490

# ─── Services ─────────────────────────────────────────────────────────────────
API_PORT=4100
GATEWAY_PORT=4110
INSTANCED_PORT=4200
# The endpoint the api hands to game clients for this relay. ALWAYS a domain, never a
# direct IP — production uses relay-social.ado.ink (DNS-only A record, no Cloudflare
# proxy: CF free doesn't carry UDP). Local dev uses localhost.
PUBLIC_ENDPOINT=localhost:4200
API_BASE_URL=http://localhost:4100
WEB_BASE_URL=http://localhost:3000

# Signs our own session JWTs and instance tickets. NOT the serika-accounts secret.
SESSION_JWT_SECRET=change-me-in-production
# instanced verifies join tickets against this; must match across api and instanced.
INSTANCE_TICKET_SECRET=change-me-in-production

# ─── Identity: serika-accounts ────────────────────────────────────────────────
ACCOUNTS_BASE_URL=http://localhost:3600
ACCOUNTS_INTERNAL_KEY=serika-internal-auth-key-change-in-production
OAUTH_CLIENT_ID=serika-social
# Public client — PKCE only, no secret. Must match the registered redirect exactly.
OAUTH_REDIRECT_URI=http://127.0.0.1:34517/callback

# ─── Storage: Backblaze B2 ────────────────────────────────────────────────────
# Use an application key scoped to THIS bucket only. Do not reuse serika-uploads'.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=serika-social
B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
CDN_BASE_URL=https://cdn-social.ado.ink
# wsrv.nl image proxy for thumbnail resize/format. IMAGE proxy only — NOT a file host.
# Thumbnails are served as ${IMAGE_PROXY_URL}/?url=<cdn-file-url>&w=..&output=webp
IMAGE_PROXY_URL=https://images.serika.chat
# When B2/CDN is unset, avatar `.ska` uploads are stored on local disk and served by the api at
# /v1/assets/file/<key>. LOCAL_ASSET_DIR is where they land; PUBLIC_API_URL is the base the api
# puts in the .ska download URL (so the game and web can fetch it).
LOCAL_ASSET_DIR=./data/assets
PUBLIC_API_URL=http://localhost:4100

# ─── WebRTC / P2P (M6) ────────────────────────────────────────────────────────
# ICE servers handed to the game by /v1/rtc/ice. STUN alone only traverses permissive NATs;
# a TURN relay (coturn — see infra/docker-compose.yml) is needed for symmetric NATs.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Self-hosted coturn (static long-term credentials, matches the coturn --user flag):
TURN_URL=turn:127.0.0.1:3478
TURN_USERNAME=serika
TURN_PASSWORD=devturnpassword
# The public IP coturn advertises for relayed candidates (set to the box's real IP in prod):
TURN_EXTERNAL_IP=127.0.0.1
# Or, instead of coturn, a Cloudflare Realtime TURN worker that mints creds per-join:
TURN_WORKER_URL=
# Gateway WebSocket the game uses for P2P signalling (offer/answer/ICE exchange):
GATEWAY_WS_URL=ws://127.0.0.1:4110/gateway

# ─── Video resolution & transcoding ───────────────────────────────────────────
# yt-dlp binary path (resolves YouTube/Bilibili/Niconico URLs to direct stream URLs).
# ffmpeg binary path (transcodes non-decodable formats to ogv/Theora for the Godot client).
# Both default to PATH lookup if unset.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Optional: cookie jar for age-gated/Bilibili sources, and egress proxy for geo-restricted content.
YTDLP_COOKIES_FILE=
YTDLP_PROXY=
